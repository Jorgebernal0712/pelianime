{
  "info": {
    "name": "PeliAnime API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "1) Ejecuta 'Login' (guarda el token automáticamente). 2) Usa las demás peticiones."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login (obtener token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pelianime.com\",\n  \"password\": \"Admin12345\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.access_token) { pm.collectionVariables.set('token', r.access_token); }",
                  "pm.test('Token recibido', () => pm.expect(r.access_token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout (revocar token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Géneros",
      "item": [
        {
          "name": "Listar géneros (público)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/generos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "generos"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Películas",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/peliculas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "peliculas"
              ]
            }
          }
        },
        {
          "name": "Ver una",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/peliculas/{{id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "peliculas",
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/peliculas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "peliculas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Dune\",\n  \"director\": \"Denis Villeneuve\",\n  \"genero_id\": 3,\n  \"anio\": 2021,\n  \"duracion_min\": 155,\n  \"calificacion\": 8.0,\n  \"sinopsis\": \"Paul Atreides llega a Arrakis.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data) pm.collectionVariables.set('id', r.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/peliculas/{{id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "peliculas",
                "{{id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calificacion\": 8.7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/peliculas/{{id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "peliculas",
                "{{id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Animes",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/animes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "animes"
              ]
            }
          }
        },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/animes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "animes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Chainsaw Man\",\n  \"estudio\": \"MAPPA\",\n  \"genero_id\": 1,\n  \"anio\": 2022,\n  \"episodios\": 12,\n  \"estado\": \"Finalizado\",\n  \"calificacion\": 8.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/animes/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "animes",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Finalizado\",\n  \"calificacion\": 9.2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/animes/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "animes",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}